---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<a href="/rss.xml">RSS</a>
	</nav>
</header>

<style>
	header {
		padding: 0 1rem;
		background: white;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 720px;
		max-width: 100%;
		margin: auto;
	}
	nav a {
		padding: 1rem 0;
		color: rgb(var(--black));
		text-decoration: none;
	}
	nav a:hover {
		color: var(--accent);
	}
	.site-title {
		font-weight: 700;
	}
</style>
